@host = https://localhost:7062

POST {{host}}/register
Content-Type: application/json

{
  "email": "prueba@test.com",
  "password": "Prueba123!"
}

###

# @name login
POST {{host}}/login
Content-Type: application/json

{
  "email": "prueba@test.com",
  "password": "Prueba123!"
}

###

PUT {{host}}/api/profile
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "name": "gaspar",
  "birthDate": "1990-05-20",
  "sex": 1,
  "heightCm": 175,
  "activityLevel": 2,
  "goal": 0
}

